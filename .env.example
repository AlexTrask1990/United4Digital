BASE_URL=http://localhost:3000

# Admin password for /admin (ads.txt + app-ads.txt)
APP_ADS_ADMIN_SECRET=

# Vercel Blob for admin save (Storage → Blob → connect to project)
# On Vercel OIDC uses BLOB_STORE_ID (+ runtime VERCEL_OIDC_TOKEN).
# Optional fallback / local: BLOB_READ_WRITE_TOKEN
# Locally without Blob vars, files are saved to /data
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
